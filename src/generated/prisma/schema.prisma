  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  plan  FcpPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  rules FcpRule[]

  @@index([planId])
  @@index([colourGroup])
}

model FcpRule {
  id          String         @id @default(cuid())
  cardId      String
  code        String         @unique
  name        String
  description String
  triggerType FcpTriggerType
  frequency   FcpFrequency
  severity    FcpSeverity
  isActive    Boolean        @default(true)
  config      Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  card        FcpCard         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tasks       FcpTask[]
  records     FcpRecord[]
  incidents   FcpIncident[]
  recordTypes FcpRecordType[]

  @@index([cardId])
  @@index([triggerType, frequency])
  @@index([isActive, severity])
}

model FcpAsset {
  id        String       @id @default(cuid())
  name      String
  type      FcpAssetType
  code      String?
  location  String?
  isActive  Boolean      @default(true)
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tasks     FcpTask[]
  records   FcpRecord[]
  incidents FcpIncident[]

  @@unique([type, code])
  @@index([type, isActive])
}

model FcpTask {
  id           String        @id @default(cuid())
  ruleId       String
  status       FcpTaskStatus @default(OPEN)
  dueAt        DateTime?
  assignedToId String?
  orderId      String?
  assetId      String?
  incidentId   String?
  context      Json?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  rule     FcpRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  asset    FcpAsset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  incident FcpIncident? @relation("IncidentTasks", fields: [incidentId], references: [id], onDelete: SetNull)
  records  FcpRecord[]

  @@index([ruleId, status])
  @@index([dueAt])
  @@index([assetId])
  @@index([incidentId])
  @@index([orderId])
}

model FcpRecordType {
  id          String   @id @default(cuid())
  ruleId      String
  code        String
  name        String
  description String?
  schema      Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rule    FcpRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  records FcpRecord[]

  @@unique([ruleId, code])
  @@index([ruleId, isActive])
}

model FcpRecord {
  id           String          @id @default(cuid())
  ruleId       String
  recordTypeId String?
  taskId       String?
  assetId      String?
  orderId      String?
  status       FcpRecordStatus @default(SUBMITTED)
  data         Json
  recordedById String?
  recordedAt   DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  rule       FcpRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  recordType FcpRecordType? @relation(fields: [recordTypeId], references: [id], onDelete: SetNull)
  task       FcpTask?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  asset      FcpAsset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([ruleId, recordedAt])
  @@index([recordTypeId])
  @@index([taskId])
  @@index([assetId])
  @@index([orderId])
}

model FcpIncident {
  id          String            @id @default(cuid())
  ruleId      String?
  assetId     String?
  orderId     String?
  title       String
  description String?
  severity    FcpSeverity       @default(HIGH)
  status      FcpIncidentStatus @default(OPEN)
  openedAt    DateTime          @default(now())
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  rule  FcpRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  asset FcpAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  tasks FcpTask[] @relation("IncidentTasks")

  @@index([status, severity])
  @@index([openedAt])
  @@index([ruleId])
  @@index([assetId])
  @@index([orderId])
}

model FcpPeriodicCleaningTask {
  id               String               @id @default(cuid())
  taskName         String
  area             String
  notes            String?
  frequency        FcpPeriodicFrequency
  isActive         Boolean              @default(true)
  applyToCars      Boolean              @default(false)
  applyToAssetType FcpAssetType?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  lastGeneratedAt  DateTime?

  @@index([isActive, frequency])
}

model FcpContact {
  id            String         @id @default(cuid())
  type          FcpContactType @default(OTHER)
  companyName   String
  contactPerson String?
  website       String?
  about         String?
  phoneNumber   String?
  email         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([type, isActive])
  @@index([companyName])
}

model CalendarDayAlert {
  id             String    @id @default(cuid())
  region         String
  date           String
  message        String
  createdByEmail String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  dismissedAt    DateTime?

  @@index([region, date, dismissedAt])
}
