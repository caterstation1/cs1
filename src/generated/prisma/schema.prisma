generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// SMS templates for client messaging
enum SmsTemplateType {
  delivery
  pickup
}

model SmsTemplate {
  id        String          @id @default(cuid())
  type      SmsTemplateType @unique
  content   String          @db.Text
  updatedAt DateTime        @updatedAt
  createdAt DateTime        @default(now())
}

model GilmoursProduct {
  id                 String   @id @default(cuid())
  sku                String   @unique
  brand              String
  description        String
  isPreferred        Boolean  @default(false)
  preferredReference String?
  preferredAllergens String[] @default([])
  packSize           String
  uom                String
  price              Float
  quantity           Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model BidfoodProduct {
  id                 String   @id @default(uuid())
  productCode        String   @unique
  brand              String
  description        String
  isPreferred        Boolean  @default(false)
  preferredReference String?
  preferredAllergens String[] @default([])
  packSize           String
  ctnQty             String
  uom                String
  qty                Int
  lastPricePaid      Float
  totalExGST         Float
  contains           String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model OtherProduct {
  id                 String   @id @default(uuid())
  name               String
  supplier           String
  description        String
  isPreferred        Boolean  @default(false)
  preferredReference String?
  preferredAllergens String[] @default([])
  listOnLabel        Boolean  @default(false)
  isVegetarian       Boolean  @default(false)
  isVegan            Boolean  @default(false)
  isHalal            Boolean  @default(false)
  cost               Float
  // Operational grouping for prep/runsheet (multiple categories supported)
  prepCategory       String? // Legacy single category field
  prepCategories     Json? // New multiple categories field (array of strings)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProduceCoProduct {
  id                 String   @id @default(uuid())
  productCode        String   @unique
  productName        String
  totalUnits         Int
  totalSales         Float
  price              Float
  isPreferred        Boolean  @default(false)
  preferredReference String?
  preferredAllergens String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Supplier {
  id               String      @id @default(uuid())
  name             String      @unique
  contactName      String?
  contactNumber    String?
  contactEmail     String?
  mpiNumber        String?
  accountNumber    String?
  loginAccessLevel String?     @default("bakery")
  password         String?
  emailSettings    Json? // Email preferences: { bakery: { enabled: boolean, autoSend: boolean } }
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  stockItems       StockItem[]
}

model Component {
  id                   String           @id @default(uuid())
  name                 String           @unique
  description          String
  ingredients          Json
  totalCost            Float
  // Operational grouping for prep/runsheet (multiple categories supported)
  prepCategory         String? // Legacy single category field
  prepCategories       Json? // New multiple categories field (array of strings)
  // Yield and cooking loss fields
  producedQuantity     Float            @default(1)
  producedUnit         String           @default("unit") // e.g., kg | g | l | ml | unit
  rawWeight            Float?
  cookedWeight         Float?
  trimWasteWeight      Float?
  weightUnit           String? // e.g., kg | g
  // Derived for performance
  costPerOutputUnit    Float            @default(0)
  normalizedOutputUnit String           @default("unit") // normalized form: kg | l | unit
  hasGluten            Boolean          @default(false)
  hasDairy             Boolean          @default(false)
  hasSoy               Boolean          @default(false)
  hasOnionGarlic       Boolean          @default(false)
  hasSesame            Boolean          @default(false)
  hasNuts              Boolean          @default(false)
  hasEgg               Boolean          @default(false)
  isVegetarian         Boolean          @default(false)
  isVegan              Boolean          @default(false)
  isHalal              Boolean          @default(false)
  isComponentListItem  Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  images               ComponentImage[]
}

// Images associated with a Component (stored in Cloudinary; DB stores metadata)
model ComponentImage {
  id          String    @id @default(uuid())
  componentId String
  publicId    String // Cloudinary public_id
  url         String // Cloudinary secure_url
  alt         String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  component   Component @relation(fields: [componentId], references: [id])

  @@index([componentId])
}

model Product {
  id             String   @id @default(uuid())
  name           String?
  description    String?
  addon          String?
  handle         String?
  meat1          String?
  meat2          String?
  option1        String?
  option2        String?
  serveware      String?
  timerA         Int?
  timerB         Int?
  skuSearch      String?
  variantSku     String?
  variant_title  String?
  ingredients    Json?
  totalCost      Float    @default(0)
  sellingPrice   Float?
  realizedMargin Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // @deprecated - Use ProductCustomData instead
}

model ProductCustomData {
  id          String   @id @default(uuid())
  variantId   String   @unique // Shopify variant_id (e.g., 43025217388799)
  meat1       String?
  meat2       String?
  option1     String?
  option2     String?
  serveware   String?
  timerA      Int?
  timerB      Int?
  ingredients Json? // Your costing/components breakdown
  totalCost   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([variantId])
}

model ProductWithCustomData {
  id        String   @id @default(cuid())
  variantId String   @unique // Shopify variant_id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Shopify data (read-only, synced from Shopify)
  shopifyProductId String
  shopifySku       String?
  shopifyName      String
  shopifyTitle     String
  shopifyPrice     Decimal
  shopifyInventory Int
  shopifyVendor    String?
  shopifyMarket    String?
  heroImageUrl     String?

  // Custom operational data (editable)
  displayName String?
  meat1       String?
  meat2       String?
  timer1      Int?
  timer2      Int?
  option1     String?
  option2     String?
  serveware   Boolean @default(false)
  isDraft     Boolean @default(false)
  ingredients Json? // Components/ingredients breakdown
  totalCost   Float   @default(0)

  @@map("product_with_custom_data")
}

model ProductRule {
  id          String  @id @default(cuid())
  name        String // Human-readable rule name
  description String? // Optional description
  isActive    Boolean @default(true)
  priority    Int     @default(0) // Higher priority rules run first

  // Rule conditions (what to match in variant title)
  matchPattern String // Text pattern to match (case-insensitive)
  matchType    String @default("contains") // contains, startsWith, endsWith, exact, regex

  // Rule actions (what to set when matched)
  setDisplayName String?
  setMeat1       String?
  setMeat2       String?
  setTimer1      Int?
  setTimer2      Int?
  setOption1     String?
  setOption2     String?
  setServeware   Boolean?

  // Ingredient rules (new fields)
  setIngredients Json? // Array of ingredients to add
  setTotalCost   Float? // Total cost to set

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_rules")
}

model Staff {
  id                         String              @id @default(uuid())
  firstName                  String
  lastName                   String
  phone                      String
  email                      String              @unique
  payRate                    Float
  accessLevel                String // staff, manager, admin, owner
  isDriver                   Boolean             @default(false)
  isActive                   Boolean             @default(true)
  includeInOpsLabour         Boolean             @default(true) // Counted in operational labour costs (off for admin/overhead staff)
  xeroEmployeeId             String? // Xero Payroll Employee UUID
  payMode                    String? // CLOCKED | FIXED_WEEKLY_HOURS
  fixedWeeklyHours           Float? // For FIXED_WEEKLY_HOURS staff
  dateOfBirth                DateTime? // For Xero payroll (required by Xero)
  addressLine1               String? // For Xero payroll
  addressCity                String? // For Xero payroll
  addressPostCode            String? // For Xero payroll
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  lastLogin                  DateTime?
  password                   String?
  resetToken                 String?             @unique
  resetTokenExpiry           DateTime?
  latestFoodSafetyQuizStatus String?
  latestScore                Int?
  latestCompletedAt          DateTime?
  shifts                     Shift[]
  locationPings              StaffLocationPing[]
  rosterAssignments          RosterAssignment[]
  wlgMessages                WLGMessage[]        @relation("MessageCreator")
}

// New: Shift Types for roster management
model ShiftType {
  id                String             @id @default(uuid())
  name              String // e.g., "Morning", "Afternoon", "Full Day", "Delivery"
  startTime         String // Format: "HH:MM" (e.g., "07:00")
  endTime           String // Format: "HH:MM" (e.g., "15:00")
  color             String             @default("#3B82F6") // Hex color for UI
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  rosterAssignments RosterAssignment[]
}

// Enhanced: Shift model (existing but with new fields)
model Shift {
  id                 String              @id @default(uuid())
  staffId            String
  clockIn            DateTime
  clockOut           DateTime?
  totalHours         Float?
  date               DateTime
  mileage            Float? // Kilometers driven
  notes              String? // Staff notes about the shift
  status             String              @default("active") // active, completed, edited
  approved           Boolean             @default(false) // For payroll: must be approved to include
  approvedAt         DateTime?
  approvedBy         String? // Staff ID who approved
  trackingAllowed    Boolean             @default(false)
  trackingStartedAt  DateTime?
  trackingStoppedAt  DateTime?
  lastLocationPingAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  staff              Staff               @relation(fields: [staffId], references: [id])
  reimbursements     Reimbursement[]
  tasks              ShiftTask[]
  locationPings      StaffLocationPing[]

  @@index([staffId])
  @@index([staffId, clockOut, status])
  @@index([date])
}

model StaffLocationPing {
  id         String   @id @default(uuid())
  staffId    String
  shiftId    String
  latitude   Float
  longitude  Float
  accuracy   Float?
  speed      Float?
  heading    Float?
  capturedAt DateTime
  createdAt  DateTime @default(now())
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId, capturedAt])
  @@index([staffId, capturedAt])
}

// New: Shift Tasks
model ShiftTask {
  id          String    @id @default(uuid())
  shiftId     String
  title       String // Task title/duty
  description String? // Optional detailed description
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shift       Shift     @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
}

// Enhanced: Roster Assignment with tasks
model RosterAssignment {
  id          String                 @id @default(uuid())
  staffId     String
  shiftTypeId String? // Made optional
  startTime   String? // Custom start time (HH:MM format)
  endTime     String? // Custom end time (HH:MM format)
  date        DateTime // Date of the shift
  notes       String? // Optional notes for the shift
  assignedBy  String // Staff ID who made the assignment
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  staff       Staff                  @relation(fields: [staffId], references: [id])
  shiftType   ShiftType?             @relation(fields: [shiftTypeId], references: [id]) // Made optional
  tasks       RosterAssignmentTask[]

  @@index([staffId])
  @@index([date])
  @@index([shiftTypeId])
}

// New: Roster Assignment Tasks
model RosterAssignmentTask {
  id                 String           @id @default(uuid())
  rosterAssignmentId String
  title              String // Task title/duty
  description        String? // Optional detailed description
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  rosterAssignment   RosterAssignment @relation(fields: [rosterAssignmentId], references: [id])

  @@index([rosterAssignmentId])
}

// New: Reimbursements
model Reimbursement {
  id          String   @id @default(uuid())
  shiftId     String
  amount      Float
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shift       Shift    @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
}

// Payroll run tracking (for auditing and duplicate prevention)
model PayrollRun {
  id             String    @id @default(uuid())
  payPeriodStart String // YYYY-MM-DD (Monday)
  payPeriodEnd   String // YYYY-MM-DD (Sunday)
  xeroPayrunId   String? // After Xero create
  createdBy      String // Staff ID
  createdAt      DateTime  @default(now())
  postedAt       DateTime? // When posted in Xero
  status         String // draft | posted | failed
  inputSnapshot  Json // { staffId: { hours, mileage, mileageDollars, reimbursements } }
}

// Xero OAuth token storage (one row per connected org)
model XeroConnection {
  id         String   @id @default(uuid())
  tenantId   String   @unique // Xero organisation ID
  tenantName String?
  tokenSet   Json // { access_token, refresh_token, expires_at, ... }
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

// Xero payroll config (single row, tenant + earnings rate mappings)
model XeroPayrollConfig {
  id                          String   @id @default(uuid())
  tenantId                    String   @unique // Xero organisation ID
  earningsRateIdOrdinaryHours String? // Xero earnings rate for ordinary hours
  earningsRateIdReimbursement String? // Xero pay item for reimbursements
  earningsRateIdMileage       String? // Xero pay item for mileage (may be $-only)
  payrollCalendarId           String? // Xero payrun calendar ID
  defaultMileageRate          Float    @default(0.80) // $ per km
  updatedAt                   DateTime @updatedAt
  createdAt                   DateTime @default(now())
}

model Order {
  id                    String    @id @default(uuid())
  shopifyId             String    @unique
  orderNumber           Int
  createdAt             DateTime
  updatedAt             DateTime
  processedAt           DateTime?
  cancelledAt           DateTime?
  closedAt              DateTime?
  totalPrice            Float
  subtotalPrice         Float
  totalTax              Float
  currency              String
  financialStatus       String
  fulfillmentStatus     String?
  tags                  String?
  note                  String?
  customerEmail         String
  customerFirstName     String
  customerLastName      String
  customerPhone         String?
  shippingAddress       Json?
  billingAddress        Json?
  lineItems             Json
  source                String    @default("shopify")
  hasLocalEdits         Boolean   @default(false)
  syncedAt              DateTime  @default(now())
  dbCreatedAt           DateTime  @default(now())
  dbUpdatedAt           DateTime  @updatedAt
  noteAttributes        Json?
  deliveryDate          String?
  deliveryTime          String?
  pickupDate            String?
  pickupTime            String?
  deliveryInstructions  String?
  travelTime            String?
  leaveTime             String?
  driverId              String?
  /// Optional assigned delivery vehicle (references Car.id; no FK to keep writes simple, similar to driverId)
  carId                 String?
  isDispatched          Boolean   @default(false)
  lastSmsSent           DateTime?
  smsHistory            Json?
  internalNote          String?
  customerNote          String?
  /// Staff-authored message included in app-sent fulfillment confirmation email to the customer
  fulfillmentClientNote String?

  // Resolved delivery day in Auckland-local calendar (DATE in DB)
  deliveryDateResolved       DateTime?                   @db.Date
  deliveryDateResolvedSource DeliveryDateResolvedSource?
  deliveryDateResolvedAt     DateTime?

  // New canonical scheduling fields (for fast calendar queries)
  deliveryDateTime      DateTime? // Canonical datetime used for calendar + ops (indexed)
  deliveryDateSource    String? // Source: field|noteAttributes|tags|createdAtFallback|unknown
  needsSchedulingReview Boolean               @default(false) // True if deliveryDateTime missing/invalid
  region                String? // Canonical region: AKL|WLG|OTHER (indexed)
  orderChangeLogs       OrderChangeLog[]
  postPurchaseFollowup  PostPurchaseFollowup?

  @@index([orderNumber])
  @@index([createdAt])
  @@index([customerEmail])
  @@index([deliveryDateResolved])
  @@index([region, deliveryDateTime])
  @@index([needsSchedulingReview])
}

model OrderChangeLog {
  id              String   @id @default(uuid())
  orderId         String
  action          String
  changedAt       DateTime @default(now())
  changedByUserId String?
  changedByName   String?
  changedByEmail  String?
  changes         Json
  source          String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, changedAt])
  @@index([changedByUserId, changedAt])
}

model ShopifyOrder {
  id            String       @id
  rawData       Json // Complete Shopify order data
  syncedAt      DateTime
  parsedOrder   ParsedOrder?
  parsedOrderId String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

/// Source for how deliveryDateResolved was computed
enum DeliveryDateResolvedSource {
  FIELD
  NOTE
  TAG
  CREATED_AT
}

model ParsedOrder {
  id              String           @id
  shopifyOrder    ShopifyOrder     @relation(fields: [shopifyOrderId], references: [id])
  shopifyOrderId  String           @unique
  orderNumber     String
  deliveryTime    String // Format: "HH:MM"
  deliveryDate    DateTime
  deliveryAddress Json // Structured address data
  customerName    String
  customerCompany String?
  customerPhone   String
  orderNotes      String?
  travelTime      Int? // In minutes
  leaveTime       String? // Format: "HH:MM"
  driverId        String?
  isDispatched    Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lineItems       ParsedLineItem[]
}

model ParsedLineItem {
  id            String      @id
  parsedOrder   ParsedOrder @relation(fields: [parsedOrderId], references: [id])
  parsedOrderId String
  sku           String
  title         String
  quantity      Int
  price         String
  // Product details from our database
  handle        String?
  meat1         String?
  meat2         String?
  serveware     String?
  ovenTimer1    Int?
  ovenTimer2    Int?
  option1       String?
  option2       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([parsedOrderId])
  @@index([sku])
}

enum CompanyMatchMethod {
  DOMAIN_EXACT
  NAME_EXACT
  NAME_AND_ADDRESS
  DOMAIN_AND_ADDRESS
  ADDRESS_EXACT
  FUZZY
  MANUAL_OVERRIDE
}

enum CompanyReviewStatus {
  pending
  approved
  rejected
}

enum CompanyAssignmentActionType {
  rename_company
  mark_domain_generic
  reassign_contact
  reassign_order
  merge_company
  split_company
  mark_private
}

model RawShopifyOrder {
  id               String   @id @default(cuid())
  shopifyOrderId   String   @unique
  shopifyOrderName String?
  payload          Json
  fetchedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([fetchedAt])
  @@map("raw_shopify_orders")
}

model RawShopifyCustomer {
  id                String   @id @default(cuid())
  shopifyCustomerId String   @unique
  email             String?
  payload           Json
  fetchedAt         DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email])
  @@index([fetchedAt])
  @@map("raw_shopify_customers")
}

model Company {
  companyId             String                   @id @default(cuid()) @map("company_id")
  canonicalCompanyName  String                   @map("canonical_company_name")
  companyNameVariants   String[]                 @default([]) @map("company_name_variants")
  primaryDomain         String?                  @map("primary_domain")
  alternateDomains      String[]                 @default([]) @map("alternate_domains")
  primaryAddress        Json?                    @map("primary_address")
  city                  String?
  region                String?
  country               String?
  confidenceScore       Int                      @default(0) @map("confidence_score")
  totalOrders           Int                      @default(0) @map("total_orders")
  totalRevenue          Float                    @default(0) @map("total_revenue")
  firstOrderDate        DateTime?                @map("first_order_date")
  lastOrderDate         DateTime?                @map("last_order_date")
  isStrategicOverride   Boolean?                 @map("is_strategic_override")
  isVipOverride         Boolean?                 @map("is_vip_override")
  lifecyclePausedUntil  DateTime?                @map("lifecycle_paused_until")
  lifecycleOverrideNote String?                  @map("lifecycle_override_note")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  contacts              CompanyContact[]
  companyOrders         CompanyOrder[]
  metricsMonthly        CompanyMetricsMonthly[]
  reviewProposals       CompanyMatchReview[]     @relation("proposed_company")
  reviewCandidates      CompanyMatchReview[]     @relation("existing_company")
  assignmentAuditsOld   CompanyAssignmentAudit[] @relation("audit_old_company")
  assignmentAuditsNew   CompanyAssignmentAudit[] @relation("audit_new_company")
  recoveryActions       CompanyRecoveryAction[]
  lifecycleEmailLogs    LifecycleEmailSendLog[]
  rewardIssues          RewardIssue[]
  postPurchaseFollowups PostPurchaseFollowup[]

  @@index([canonicalCompanyName])
  @@index([primaryDomain])
  @@index([lastOrderDate])
  @@map("companies")
}

model GenericDomain {
  domain    String   @id
  reason    String?
  addedBy   String?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("generic_domains")
}

model CompanyContact {
  contactId             String                  @id @default(cuid()) @map("contact_id")
  companyId             String                  @map("company_id")
  shopifyCustomerId     String?                 @map("shopify_customer_id")
  firstName             String?                 @map("first_name")
  lastName              String?                 @map("last_name")
  email                 String?
  phone                 String?
  role                  String?
  firstOrderDate        DateTime?               @map("first_order_date")
  lastOrderDate         DateTime?               @map("last_order_date")
  totalOrders           Int                     @default(0) @map("total_orders")
  totalSpend            Float                   @default(0) @map("total_spend")
  isPrimaryContact      Boolean                 @default(false) @map("is_primary_contact")
  lifecycleOptOut       Boolean                 @default(false) @map("lifecycle_opt_out")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  company               Company                 @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  lifecycleEmailLogs    LifecycleEmailSendLog[]
  rewardIssues          RewardIssue[]
  postPurchaseFollowups PostPurchaseFollowup[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([shopifyCustomerId])
  @@index([email])
  @@map("company_contacts")
}

enum PostPurchaseFollowupStatus {
  pending_review
  previewed
  test_sent
  sent
  skipped
  no_followup
  completed
  blocked
}

enum PostPurchaseFollowupActionType {
  previewed
  test_sent
  send_attempted
  sent
  skipped
  no_followup
  marked_blocked
  marked_fulfilled
  reward_selected
  reward_issued
  strategic_marked
}

model CompanyOrder {
  companyOrderId    String             @id @default(cuid()) @map("company_order_id")
  companyId         String             @map("company_id")
  shopifyOrderId    String             @map("shopify_order_id")
  shopifyCustomerId String?            @map("shopify_customer_id")
  orderDate         DateTime           @map("order_date")
  orderTotal        Float              @default(0) @map("order_total")
  orderSubtotal     Float              @default(0) @map("order_subtotal")
  discounts         Float              @default(0)
  refunds           Float              @default(0)
  products          Json?
  deliveryAddress   Json?              @map("delivery_address")
  billingAddress    Json?              @map("billing_address")
  sourceChannel     String?            @map("source_channel")
  matchMethod       CompanyMatchMethod @map("match_method")
  confidenceScore   Int                @default(0) @map("confidence_score")
  matchReason       String?            @map("match_reason")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  company           Company            @relation(fields: [companyId], references: [companyId], onDelete: Cascade)

  @@unique([companyId, shopifyOrderId])
  @@unique([shopifyOrderId])
  @@index([companyId, orderDate])
  @@index([shopifyCustomerId])
  @@map("company_orders")
}

model CompanyMatchReview {
  reviewId            String              @id @default(cuid()) @map("review_id")
  proposedCompanyId   String?             @map("proposed_company_id")
  proposedCompanyName String              @map("proposed_company_name")
  existingCompanyId   String?             @map("existing_company_id")
  existingCompanyName String?             @map("existing_company_name")
  matchReason         String              @map("match_reason")
  confidenceScore     Int                 @map("confidence_score")
  orderIds            Json                @map("order_ids")
  status              CompanyReviewStatus @default(pending)
  createdAt           DateTime            @default(now()) @map("created_at")
