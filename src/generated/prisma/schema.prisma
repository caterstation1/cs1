generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// SMS templates for client messaging
enum SmsTemplateType {
  delivery
  pickup
}

model SmsTemplate {
  id        String          @id @default(cuid())
  type      SmsTemplateType @unique
  content   String          @db.Text
  updatedAt DateTime        @updatedAt
  createdAt DateTime        @default(now())
}

model GilmoursProduct {
  id          String   @id @default(cuid())
  sku         String   @unique
  brand       String
  description String
  packSize    String
  uom         String
  price       Float
  quantity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BidfoodProduct {
  id            String   @id @default(uuid())
  productCode   String   @unique
  brand         String
  description   String
  packSize      String
  ctnQty        String
  uom           String
  qty           Int
  lastPricePaid Float
  totalExGST    Float
  contains      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OtherProduct {
  id             String   @id @default(uuid())
  name           String
  supplier       String
  description    String
  cost           Float
  // Operational grouping for prep/runsheet (multiple categories supported)
  prepCategory   String? // Legacy single category field
  prepCategories Json? // New multiple categories field (array of strings)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Supplier {
  id            String      @id @default(uuid())
  name          String      @unique
  contactName   String?
  contactNumber String?
  contactEmail  String?
  emailSettings Json? // Email preferences: { bakery: { enabled: boolean, autoSend: boolean } }
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  stockItems    StockItem[]
}

model Component {
  id                   String           @id @default(uuid())
  name                 String           @unique
  description          String
  ingredients          Json
  totalCost            Float
  // Operational grouping for prep/runsheet (multiple categories supported)
  prepCategory         String? // Legacy single category field
  prepCategories       Json? // New multiple categories field (array of strings)
  // Yield and cooking loss fields
  producedQuantity     Float            @default(1)
  producedUnit         String           @default("unit") // e.g., kg | g | l | ml | unit
  rawWeight            Float?
  cookedWeight         Float?
  trimWasteWeight      Float?
  weightUnit           String? // e.g., kg | g
  // Derived for performance
  costPerOutputUnit    Float            @default(0)
  normalizedOutputUnit String           @default("unit") // normalized form: kg | l | unit
  hasGluten            Boolean          @default(false)
  hasDairy             Boolean          @default(false)
  hasSoy               Boolean          @default(false)
  hasOnionGarlic       Boolean          @default(false)
  hasSesame            Boolean          @default(false)
  hasNuts              Boolean          @default(false)
  hasEgg               Boolean          @default(false)
  isVegetarian         Boolean          @default(false)
  isVegan              Boolean          @default(false)
  isHalal              Boolean          @default(false)
  isComponentListItem  Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  images               ComponentImage[]
}

// Images associated with a Component (stored in Cloudinary; DB stores metadata)
model ComponentImage {
  id          String    @id @default(uuid())
  componentId String
  publicId    String // Cloudinary public_id
  url         String // Cloudinary secure_url
  alt         String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  component   Component @relation(fields: [componentId], references: [id])

  @@index([componentId])
}

model Product {
  id             String   @id @default(uuid())
  name           String?
  description    String?
  addon          String?
  handle         String?
  meat1          String?
  meat2          String?
  option1        String?
  option2        String?
  serveware      String?
  timerA         Int?
  timerB         Int?
  skuSearch      String?
  variantSku     String?
  variant_title  String?
  ingredients    Json?
  totalCost      Float    @default(0)
  sellingPrice   Float?
  realizedMargin Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // @deprecated - Use ProductCustomData instead
}

model ProductCustomData {
  id          String   @id @default(uuid())
  variantId   String   @unique // Shopify variant_id (e.g., 43025217388799)
  meat1       String?
  meat2       String?
  option1     String?
  option2     String?
  serveware   String?
  timerA      Int?
  timerB      Int?
  ingredients Json? // Your costing/components breakdown
  totalCost   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([variantId])
}

model ProductWithCustomData {
  id        String   @id @default(cuid())
  variantId String   @unique // Shopify variant_id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Shopify data (read-only, synced from Shopify)
  shopifyProductId String
  shopifySku       String?
  shopifyName      String
  shopifyTitle     String
  shopifyPrice     Decimal
  shopifyInventory Int
  shopifyVendor    String?
  shopifyMarket    String?
  heroImageUrl     String?

  // Custom operational data (editable)
  displayName String?
  meat1       String?
  meat2       String?
  timer1      Int?
  timer2      Int?
  option1     String?
  option2     String?
  serveware   Boolean @default(false)
  isDraft     Boolean @default(false)
  ingredients Json? // Components/ingredients breakdown
  totalCost   Float   @default(0)

  @@map("product_with_custom_data")
}

model ProductRule {
  id          String  @id @default(cuid())
  name        String // Human-readable rule name
  description String? // Optional description
  isActive    Boolean @default(true)
  priority    Int     @default(0) // Higher priority rules run first

  // Rule conditions (what to match in variant title)
  matchPattern String // Text pattern to match (case-insensitive)
  matchType    String @default("contains") // contains, startsWith, endsWith, exact, regex

  // Rule actions (what to set when matched)
  setDisplayName String?
  setMeat1       String?
  setMeat2       String?
  setTimer1      Int?
  setTimer2      Int?
  setOption1     String?
  setOption2     String?
  setServeware   Boolean?

  // Ingredient rules (new fields)
  setIngredients Json? // Array of ingredients to add
  setTotalCost   Float? // Total cost to set

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_rules")
}

model Staff {
  id                String             @id @default(uuid())
  firstName         String
  lastName          String
  phone             String
  email             String             @unique
  payRate           Float
  accessLevel       String // staff, manager, admin, owner
  isDriver          Boolean            @default(false)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lastLogin         DateTime?
  password          String?
  resetToken        String?            @unique
  resetTokenExpiry  DateTime?
  shifts            Shift[]
  rosterAssignments RosterAssignment[]
  wlgMessages       WLGMessage[]       @relation("MessageCreator")
}

// New: Shift Types for roster management
model ShiftType {
  id                String             @id @default(uuid())
  name              String // e.g., "Morning", "Afternoon", "Full Day", "Delivery"
  startTime         String // Format: "HH:MM" (e.g., "07:00")
  endTime           String // Format: "HH:MM" (e.g., "15:00")
  color             String             @default("#3B82F6") // Hex color for UI
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  rosterAssignments RosterAssignment[]
}

// Enhanced: Shift model (existing but with new fields)
model Shift {
  id             String          @id @default(uuid())
  staffId        String
  clockIn        DateTime
  clockOut       DateTime?
  totalHours     Float?
  date           DateTime
  mileage        Float? // Kilometers driven
  notes          String? // Staff notes about the shift
  status         String          @default("active") // active, completed, edited
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  staff          Staff           @relation(fields: [staffId], references: [id])
  reimbursements Reimbursement[]
  tasks          ShiftTask[]

  @@index([staffId])
  @@index([date])
}

// New: Shift Tasks
model ShiftTask {
  id          String    @id @default(uuid())
  shiftId     String
  title       String // Task title/duty
  description String? // Optional detailed description
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shift       Shift     @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
}

// Enhanced: Roster Assignment with tasks
model RosterAssignment {
  id          String                 @id @default(uuid())
  staffId     String
  shiftTypeId String? // Made optional
  startTime   String? // Custom start time (HH:MM format)
  endTime     String? // Custom end time (HH:MM format)
  date        DateTime // Date of the shift
  notes       String? // Optional notes for the shift
  assignedBy  String // Staff ID who made the assignment
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  staff       Staff                  @relation(fields: [staffId], references: [id])
  shiftType   ShiftType?             @relation(fields: [shiftTypeId], references: [id]) // Made optional
  tasks       RosterAssignmentTask[]

  @@index([staffId])
  @@index([date])
  @@index([shiftTypeId])
}

// New: Roster Assignment Tasks
model RosterAssignmentTask {
  id                 String           @id @default(uuid())
  rosterAssignmentId String
  title              String // Task title/duty
  description        String? // Optional detailed description
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  rosterAssignment   RosterAssignment @relation(fields: [rosterAssignmentId], references: [id])

  @@index([rosterAssignmentId])
}

// New: Reimbursements
model Reimbursement {
  id          String   @id @default(uuid())
  shiftId     String
  amount      Float
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shift       Shift    @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
}

model Order {
  id                   String    @id @default(uuid())
  shopifyId            String    @unique
  orderNumber          Int
  createdAt            DateTime
  updatedAt            DateTime
  processedAt          DateTime?
  cancelledAt          DateTime?
  closedAt             DateTime?
  totalPrice           Float
  subtotalPrice        Float
  totalTax             Float
  currency             String
  financialStatus      String
  fulfillmentStatus    String?
  tags                 String?
  note                 String?
  customerEmail        String
  customerFirstName    String
  customerLastName     String
  customerPhone        String?
  shippingAddress      Json?
  billingAddress       Json?
  lineItems            Json
  source               String    @default("shopify")
  hasLocalEdits        Boolean   @default(false)
  syncedAt             DateTime  @default(now())
  dbCreatedAt          DateTime  @default(now())
  dbUpdatedAt          DateTime  @updatedAt
  noteAttributes       Json?
  deliveryDate         String?
  deliveryTime         String?
  pickupDate           String?
  pickupTime           String?
  deliveryInstructions String?
  travelTime           String?
  leaveTime            String?
  driverId             String?
  /// Optional assigned delivery vehicle (references Car.id; no FK to keep writes simple, similar to driverId)
  carId                String?
  isDispatched         Boolean   @default(false)
  lastSmsSent          DateTime?
  smsHistory           Json?
  internalNote         String?

  // Resolved delivery day in Auckland-local calendar (DATE in DB)
  deliveryDateResolved       DateTime?                   @db.Date
  deliveryDateResolvedSource DeliveryDateResolvedSource?
  deliveryDateResolvedAt     DateTime?

  @@index([orderNumber])
  @@index([createdAt])
  @@index([customerEmail])
  @@index([deliveryDateResolved])
}

model ShopifyOrder {
  id            String       @id
  rawData       Json // Complete Shopify order data
  syncedAt      DateTime
  parsedOrder   ParsedOrder?
  parsedOrderId String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

/// Source for how deliveryDateResolved was computed
enum DeliveryDateResolvedSource {
  FIELD
  NOTE
  TAG
  CREATED_AT
}

model ParsedOrder {
  id              String           @id
  shopifyOrder    ShopifyOrder     @relation(fields: [shopifyOrderId], references: [id])
  shopifyOrderId  String           @unique
  orderNumber     String
  deliveryTime    String // Format: "HH:MM"
  deliveryDate    DateTime
  deliveryAddress Json // Structured address data
  customerName    String
  customerCompany String?
  customerPhone   String
  orderNotes      String?
  travelTime      Int? // In minutes
  leaveTime       String? // Format: "HH:MM"
  driverId        String?
  isDispatched    Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lineItems       ParsedLineItem[]
}

model ParsedLineItem {
  id            String      @id
  parsedOrder   ParsedOrder @relation(fields: [parsedOrderId], references: [id])
  parsedOrderId String
  sku           String
  title         String
  quantity      Int
  price         String
  // Product details from our database
  handle        String?
  meat1         String?
  meat2         String?
  serveware     String?
  ovenTimer1    Int?
  ovenTimer2    Int?
  option1       String?
  option2       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([parsedOrderId])
  @@index([sku])
}

// New Product Architecture
model ShopifyProduct {
  id                 String   @id @default(cuid())
  shopifyProductId   String   @unique
  productTitle       String
  displayName        String?
  heroImageUrl       String?
  shopifyVendor      String?
  shopifyMarket      String?
  isActive           Boolean  @default(true)
  baseIngredients    Json? // Base components applied to all variants
  // Party pack defaults at product level
  isPartyPackDefault Boolean  @default(false)
  bundleDefaultItems Json?
  bakery             Boolean  @default(false) // Bakery product flag
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  variants ProductVariant[]

  @@map("shopify_products")
}

model ProductVariant {
  id               String  @id @default(cuid())
  productId        String
  variantId        String  @unique // Shopify variant_id
  shopifySku       String?
  shopifyName      String // Variant display name
  shopifyTitle     String // Full title with variant options
  shopifyPrice     Decimal
  shopifyInventory Int

  // Operational fields (user-configurable)
  displayName String?
  meat1       String?
  meat2       String?
  timer1      Int?
  timer2      Int?
  option1     String?
  option2     String?
  // New array-based fields (preferred going forward)
  meats       Json?
  timers      Json?
  options     Json?
  serveware   Boolean @default(false)
  isDraft     Boolean @default(false)
  // Party pack (bundle) support
  isPartyPack Boolean @default(false)
  bundleItems Json?

  // Component/costing data
  ingredients Json? // Array of components
  totalCost   Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([productId])
  @@map("product_variants")
}

// Email automation settings
model EmailSetting {
  id             String   @id @default(uuid())
  name           String   @unique // e.g., "WLG_3DAY_OUTLOOK"
  title          String // e.g., "Email WLG 3 Day Orders"
  description    String? // Optional description
  recipientEmail String // Email address to send to
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// WLG Communications/Message Board
model WLGMessage {
  id                String    @id @default(cuid())
  content           String    @db.Text
  createdBy         String // Staff ID
  createdByName     String // Cache for display
  createdAt         DateTime  @default(now())
  status            String    @default("new") // new | understood | actioned | archived
  statusChangedAt   DateTime? // When status last changed
  mentionedStaffIds Json? // Array of staff IDs mentioned with @
  mentionedOrders   Json? // Array of order numbers mentioned with @ORDER-
  parentId          String? // For replies (null = top-level)
  stockOrderId      String?   @unique

  creator    Staff        @relation("MessageCreator", fields: [createdBy], references: [id])
  parent     WLGMessage?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    WLGMessage[] @relation("MessageReplies")
  stockOrder StockOrder?  @relation(fields: [stockOrderId], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([parentId])
  @@index([createdBy])
  @@map("wlg_messages")
}

// Cart items (per city)
model CartItem {
  id        String   @id @default(cuid())
  city      String
  name      String
  sku       String?
  supplier  String
  qty       Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([supplier])
  @@index([sku])
}

// Stock storefront
model StockItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  supplierId  String
  sku         String?
  priceExGst  Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier   Supplier         @relation(fields: [supplierId], references: [id])
  orderItems StockOrderItem[]

  @@index([supplierId])
}

model StockOrder {
  id            String   @id @default(cuid())
  createdBy     String
  createdByName String
  status        String   @default("new") // new | confirmed | shipped | received
  subtotalExGst Decimal  @db.Decimal(12, 2)
  gst15         Decimal  @db.Decimal(12, 2)
  totalIncGst   Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items   StockOrderItem[]
  message WLGMessage?

  @@index([status])
  @@index([createdAt])
}

model StockOrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  stockItemId          String
  nameSnapshot         String
  supplierNameSnapshot String
  unitPriceExGst       Decimal @db.Decimal(10, 2)
  qty                  Int
  lineTotalExGst       Decimal @db.Decimal(12, 2)

  order     StockOrder @relation(fields: [orderId], references: [id])
  stockItem StockItem  @relation(fields: [stockItemId], references: [id])

  @@index([orderId])
  @@index([stockItemId])
}

// Fleet cars for Admin S dashboard
model Car {
  id         String    @id @default(cuid())
  name       String
  rego       String
  wofExpiry  DateTime?
  regoExpiry DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Simple dashboard todos
model DashboardTodo {
  id          String   @id @default(cuid())
  userId      String
  content     String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// DataDrivers: external contract drivers
model DataDriver {
  id              String   @id @default(cuid())
  fullName        String
  phone           String   @unique
  email           String?
  status          String   @default("pending") // pending|active|rejected|suspended|archived
  availability    Boolean  @default(false)
  vehicleMake     String?
  vehicleModel    String?
  vehiclePlate    String?
  vehiclePhotoUrl String?
  licencePhotoUrl String?
  bankAccountEnc  String? // encrypted blob
  baseSuburb      String?
  internalNotes   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications DataDriverApplication[]
}

model DataDriverApplication {
  id          String    @id @default(cuid())
  driverId    String?
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewerId  String?
  decision    String    @default("pending") // pending|approved|rejected
  adminNotes  String?

  driver DataDriver? @relation(fields: [driverId], references: [id])

  @@index([driverId])
}

model DeliveryJob {
  id                  String    @id @default(cuid())
  orderId             String
  pickupAddress       String
  dropoffAddress      String
  deliveryWindowStart DateTime?
  deliveryWindowEnd   DateTime?
  payout              Float     @default(0)
  notes               String?
  status              String    @default("draft") // draft|offered|assigned|in_progress|delivered|closed|cancelled
  assignedDriverId    String?
  deliveredAt         DateTime?
  deliveredNote       String?
  deliveredProofUrl   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([assignedDriverId])
}

model JobOffer {
  id          String    @id @default(cuid())
  jobId       String
  driverId    String
  status      String    @default("offered") // offered|accepted|declined|expired
  offeredAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([jobId])
  @@index([driverId])
  @@index([status])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  eventType String // offer_sent|accept|decline|assign|cancel|deliver
  actor     String // admin|driver|system
  data      Json?
  timestamp DateTime @default(now())

  @@index([jobId])
  @@index([timestamp])
}
