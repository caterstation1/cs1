    "test:costing-options": "npx tsx src/lib/costing/__tests__/options.test.ts",
    "test:recipe-lines": "npx tsx src/lib/recipe-builder/__tests__/lines.test.ts",
    "test:roster-labour-target": "npx tsx src/lib/roster/__tests__/labour-target.test.ts",
    "test:pricing": "npm run test:pricing-units && npm run test:pricing-packsize && npm run test:pricing-cost && npm run test:pricing-recalc && npm run test:pricing-bundle && npm run test:pricing-variant-save && npm run test:pricing-ingest && npm run test:costing-options && npm run test:recipe-lines",
    "pricing:parity": "npx tsx scripts/pricing-parity-report.ts",
    "postinstall": "prisma generate && node scripts/fix-prisma-enum.js",
    "backfill:scheduling": "npx tsx scripts/backfill-order-scheduling.ts",
    "backfill:company-normalization": "npx tsx scripts/backfill-company-normalization.ts",
    "backfill:private-customers": "npx tsx scripts/backfill-private-customers.ts",
    "backfill:ingredient-master": "npx tsx scripts/backfill-ingredient-master.ts",
