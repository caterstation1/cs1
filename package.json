    "db:migrate:deploy": "prisma migrate deploy",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test:company-normalization": "npx tsx src/lib/company-matching/company-matching.test.ts",
    "test:company-idempotency": "npx tsx scripts/test-company-upsert-idempotency.ts",
    "test:executive-dashboard": "npx tsx src/lib/dashboard/__tests__/executive-dashboard.test.ts",
    "test:lifecycle-mvp": "npx tsx src/lib/lifecycle/__tests__/lifecycle-mvp.test.ts",
    "test:pricing-units": "npx tsx src/lib/pricing/__tests__/units.test.ts",
